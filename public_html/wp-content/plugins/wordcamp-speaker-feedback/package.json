	"devDependencies": {
		"@wordpress/scripts": "32.4.0",
		"sass": "1.100.0"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"stylelint": {
		"extends": "../../../../.stylelintrc"
	},
	"scripts": {
		"start": "sass assets/scss:assets/build --watch --source-map-embed",
