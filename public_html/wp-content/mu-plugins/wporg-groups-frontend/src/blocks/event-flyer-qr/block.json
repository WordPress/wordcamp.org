{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wporg/event-flyer-qr",
	"version": "1.0.0",
	"title": "Event Flyer QR Code",
	"category": "widgets",
	"icon": "screenoptions",
	"description": "A QR code that opens the event, with its address printed underneath.",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"inserter": false,
		"spacing": { "margin": true }
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-index.css"
}
