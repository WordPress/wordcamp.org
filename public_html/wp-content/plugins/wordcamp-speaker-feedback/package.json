		"format:js": "echo \"No formatting.\"",
		"lint:js": "wp-scripts lint-js --config=../../../../eslint.config.cjs assets/js/*.js",
		"lint:css": "wp-scripts lint-style 'assets/scss/*.scss'"
	}
