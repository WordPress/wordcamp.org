{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wporg/event-flyer-link",
	"version": "1.0.0",
	"title": "Event Flyer Link",
	"category": "widgets",
	"icon": "media-document",
	"description": "Links an event to its printable flyer, or the flyer back to its event.",
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [ "event", "flyer" ],
			"default": "event"
		}
	},
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"inserter": false,
		"spacing": { "margin": true }
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-index.css"
}
