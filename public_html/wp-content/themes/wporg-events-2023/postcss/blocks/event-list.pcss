.wporg-marker-list__container {
	padding-left: 0;

	& .wporg-marker-list-item {
		border: 1px solid var(--wp--preset--color--light-grey-1);
		border-bottom: none;
		padding: var(--wp--preset--spacing--20);
		list-style: none;
		font-size: var(--wp--preset--font-size--small);

		&:first-child {
			border-radius: 2px 2px 0 0;
		}

		&:last-child {
			border-radius: 0 0 2px 2px;
			border-bottom: 1px solid var(--wp--preset--color--light-grey-1);
		}

		@media (--large) {
			display: grid;
			align-items: start;
			gap: var(--wp--preset--spacing--20);
			grid-template-columns: 45% 1fr 2fr;
		}

		@media (--xlarge) {
			font-size: var(--wp--preset--font-size--normal);
		}

		@media (--wide) {
			grid-template-columns: 60% 1fr 1fr;
		}

		& .wporg-marker-list-item__title {
			margin: 0;
			font-family: var(--wp--preset--font-family--inter);
			font-size: var(--wp--preset--font-size--small);
			line-height: var(--wp--custom--body--typography--line-height);
			--wp--preset--spacing--30: 0;

			& a {
				text-decoration: none;
			}

			@media (--xlarge) {
				font-size: var(--wp--preset--font-size--normal);
			}
		}

		& .wporg-marker-list-item__location {
			&::first-letter {
			    text-transform: capitalize;
			}

			@media (--medium-small) {
				margin-top: 2px;
				margin-bottom: -2px;
			}

			@media (--small) {
				display: inline;
			}
		}

		& .wporg-marker-list-item__date-time {

			@media (--small) {
				display: inline-flex;
				justify-content: flex-end;
				white-space: nowrap;
				align-items: center;
			}

			@media (--wide) {
				display: flex;
			}
		}

		& .wporg-marker-list-item__location::after,
		& .wporg-google-map__date::after {
			content: "";
			margin-top: -1px; /* vertical-middle doesn't subtract the size of the element */
			margin-left: 10px;
			margin-right: 10px;
			height: 3px;
			width: 3px;
			border-radius: 3px;
			background: var(--wp--preset--color--charcoal-5);
			display: inline-block;
			vertical-align: middle;
		}

		& .wporg-marker-list-item__location::after {

			@media (--small-only), (--large) {
				display: none;
			}
		}
	}
}

body.home .wporg-marker-list__loading {
	/* The final height could be anywhere between 50px and 750px, so split the difference in order to minimize the
	 * amount of layout shift. */
	height: 350px;
}

body.page-slug-upcoming-events .wporg-marker-list__loading {
	/* Take up most of the viewport to avoid a large layout shift. We know this list will have a lot of entries. */
	height: 90vh;
}

.wporg-event-list__nearby {
	margin-bottom: var(--wp--preset--spacing--50);

	& .wporg-event-list__nearby-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--wp--preset--spacing--10) var(--wp--preset--spacing--20);
		margin-bottom: var(--wp--preset--spacing--10);

		& h2 {
			margin: 0;
		}
	}

	& .wporg-event-list__nearby-location {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin: 0;
		padding: 4px 14px 4px 10px;
		border: 1px solid var(--wp--preset--color--blueberry-1);
		border-radius: 999px;
		font-size: var(--wp--preset--font-size--small);

		& svg {
			color: var(--wp--preset--color--blueberry-1);
		}
	}

	& .wporg-event-list__nearby-change {
		padding: 0;
		border: 0;
		background: none;
		color: var(--wp--preset--color--blueberry-1);
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}

	& .wporg-event-list__nearby-form {
		display: flex;
		gap: var(--wp--preset--spacing--10);

		& input {
			padding: 6px 10px;
			border: 1px solid var(--wp--preset--color--charcoal-4);
			border-radius: 2px;
			font-size: var(--wp--preset--font-size--small);
		}

		& button {
			padding: 6px 16px;
			font-size: var(--wp--preset--font-size--small);
		}
	}

	& .wporg-event-list__nearby-description {
		margin-top: 0;
		color: var(--wp--preset--color--charcoal-4);
		font-size: var(--wp--preset--font-size--x-small);
	}

	& .wporg-marker-list__loading {
		/* Nearby lists are short, so reserve less room than the global list does. */
		height: 200px;
	}

	& .wporg-marker-list-item__type {
		margin-left: 6px;
		color: var(--wp--preset--color--charcoal-4);
		font-size: var(--wp--preset--font-size--x-small);
		text-transform: uppercase;
		white-space: nowrap;
	}

	& .wporg-event-list__nearby-empty {
		padding: var(--wp--preset--spacing--20);
		border: 1px solid var(--wp--preset--color--light-grey-1);
		border-radius: 2px;

		& p {
			margin: 0;
		}
	}

	/* The rules above set `display`, which would otherwise win over the global helper. */
	&.wporg-events__hidden,
	& .wporg-events__hidden {
		display: none;
	}
}
